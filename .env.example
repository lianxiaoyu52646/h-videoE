# Copy to .env for local web mode, or set in Render dashboard.

APP_MODE=web
APP_NAME=WordPop 单词泡泡
LOCAL_AUTO_USER=0
INLINE_WORKER=1
SECRET_KEY=change-me-in-production

# Local sqlite (default when APP_MODE=web without DATABASE_URL):
# DATABASE_URL=sqlite:///./db.sqlite3

# Render Postgres (auto-injected as DATABASE_URL). Supported forms:
# postgres://...
# postgresql://...
# postgresql+psycopg://...

# Optional CORS for separate frontends:
# CORS_ORIGINS=https://your-app.onrender.com
