{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VideoEnglish",
  "version": "0.1.0",
  "identifier": "com.videoenglish.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VideoEnglish",
        "url": "http://127.0.0.1:18555",
        "width": 1480,
        "height": 960,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../sidecar/videoenglish-backend/**/*"
    ]
  }
}
